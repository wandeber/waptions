              "playhead",
              "zoom",
              "scroll",
              "rowHeights",
              "layout",
              "focus",
              "presentation"
            ]
          }
        }
      }
    },
    "SourceInvalidatedEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "reason"
      ],
      "properties": {

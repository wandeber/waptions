{
  "name": "@waptions/agent-runtime",
  "version": "2026.7.25",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run mcp",
    "test:bridge": "vitest run http-bridge",
    "test:protocol": "vitest run server",
    "verify": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "ajv": "8.20.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.20",
    "typescript": "5.7.3",
    "vitest": "4.1.8"
  }
}

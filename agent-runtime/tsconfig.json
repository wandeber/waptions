{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "verbatimModuleSyntax": true
  },
  "include": [
    "coordinator/**/*.ts",
    "http-bridge/**/*.ts",
    "mcp/**/*.ts",
    "media/**/*.ts",
    "render/**/*.ts",
    "runtime/**/*.ts",
    "server/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}

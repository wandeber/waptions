{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "exclude": [
    "dist",
    "node_modules",
    "mcp/**/*.test.ts",
    "http-bridge/**/*.test.ts",
    "server/**/*.test.ts",
    "server/test-fixtures/**"
  ]
}

{
  "name": "waptions",
  "version": "2026.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.1.3",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "next dev --port 59940",
    "build": "next build",
    "start": "next start --port 59940",
    "lint": "eslint .",
    "cf-build": "opennextjs-cloudflare build",
    "cf-preview": "opennextjs-cloudflare build -e preview && opennextjs-cloudflare preview -e preview",
    "cf-deploy-preview": "opennextjs-cloudflare build -e preview && opennextjs-cloudflare deploy -e preview",
    "cf-deploy-production": "opennextjs-cloudflare build -e production && opennextjs-cloudflare deploy -e production",
    "upload-env": "node --env-file .env scripts/upload-env-to-cloudflare.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:e2e:full": "playwright test && playwright show-report"
  },
  "dependencies": {
    "@deepgram/sdk": "^4.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@huggingface/transformers": "4.2.0",
    "autoprefixer": "^10.5.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "mediabunny": "^1.29.1",
    "next": "^15.5.19",
    "next-auth": "^5.0.0-beta.30",
    "openai": "^6.42.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.77.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@opennextjs/cloudflare": "^1.19.11",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.19.20",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.5.19",
    "postcss": "8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.98.0"
  },
  "description": "This is a [Next.js](https://nextjs.org) project bootstrapped with [`create-next-app`](https://nextjs.org/docs/app/api-reference/cli/create-next-app).",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "MIT"
}
